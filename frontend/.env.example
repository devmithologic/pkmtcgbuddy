# Copy to .env:  cp .env.example .env
#
# Vite only exposes to the browser the variables that start with VITE_. Everything
# else stays in the build process.
#
# IMPORTANT: a VITE_ variable is NOT a secret. Its value gets embedded in the
# JavaScript that ships to the browser, so anyone can read it by viewing the
# page source. API keys and passwords go in the backend, never here.

VITE_API_URL=http://localhost:8000
