# Copia a .env:  cp .env.example .env
#
# Vite solo expone al navegador las variables que empiezan por VITE_. El resto se
# quedan en el proceso de build.
#
# IMPORTANTE: una variable VITE_ NO es un secreto. Su valor se incrusta en el
# JavaScript que se descarga el navegador, así que cualquiera puede leerlo con
# ver el código fuente. Claves de API y contraseñas van en el backend, nunca aquí.

VITE_API_URL=http://localhost:8000
