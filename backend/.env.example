# Copia este fichero a .env y ajusta los valores.
#   cp .env.example .env
#
# .env NO se commitea (está en .gitignore). Este fichero sí: documenta qué claves
# hacen falta para arrancar, sin contener ningún valor real.

# Cadena de conexión a MongoDB. En local, el puerto por defecto es 27017.
MONGODB_URI=mongodb://localhost:27017

# Nombre de la base de datos. MongoDB la crea sola al escribir el primer documento.
DB_NAME=pkmtcgbuddy

# Orígenes que pueden llamar a esta API desde un navegador (separados por coma).
# 5173 es el puerto por defecto del servidor de desarrollo de Vite.
CORS_ORIGINS=http://localhost:5173
