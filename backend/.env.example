# Copy this file to .env and adjust the values.
#   cp .env.example .env
#
# .env is NOT committed (it's in .gitignore). This file is: it documents which
# keys are needed to start up, without holding any real value.

# MongoDB connection string. Locally, the default port is 27017.
MONGODB_URI=mongodb://localhost:27017

# Database name. MongoDB creates it on its own when the first document is written.
DB_NAME=pkmtcgbuddy

# Origins allowed to call this API from a browser (comma-separated).
# 5173 is Vite's dev server default port.
CORS_ORIGINS=http://localhost:5173
